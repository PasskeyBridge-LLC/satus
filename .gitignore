# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
.output
# Build output. .output is Nitro's; .vercel/output is the Vercel adapter's
# copy of the same thing. Committing the latter is actively dangerous —
# Vercel treats a checked-in .vercel/output as prebuilt output and ships it
# instead of building from source, so the deployed site silently freezes at
# whatever was committed. See the 2026-08-10 rss.xml incident.
.vercel
.vinxi
.tanstack/**
.nitro
*.local
# Env files are never tracked (2026-09-27). Values live in the Vercel
# project env and, locally, in .env.local. Only the names-only template is
# committed.
.env*
!.env.example

# Wrangler / Cloudflare
.wrangler/
.dev.vars

# Supabase CLI local state
supabase/.temp/
supabase/.branches/

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# TypeScript incremental build cache (machine-local, never commit)
*.tsbuildinfo
