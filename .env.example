# Names only. This repository is public: never put a value in this file.
# Deploys read the Vercel project env (Production and Preview). For local
# work, copy this file to .env.local (gitignored) and fill it in.
#
# Build-time, inlined into the client bundle by vite.config.ts (publishable
# values only):
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Stripe publishable key. pk_test_ -> sandbox, pk_live_ -> live (src/lib/stripe.ts).
VITE_PAYMENTS_CLIENT_TOKEN=
#
# Server-only (Vercel env, never VITE_-prefixed). Optional locally; the server
# Supabase client falls back to the VITE_ values above for URL and key.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
STRIPE_LIVE_SECRET_KEY=
STRIPE_SANDBOX_SECRET_KEY=
PAYMENTS_LIVE_WEBHOOK_SECRET=
PAYMENTS_SANDBOX_WEBHOOK_SECRET=
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
ALERTS_TO_EMAIL=
ALERTS_FROM_EMAIL=
CRON_SECRET=
XAI_API_KEY=
XAI_BASE_URL=
PUBLIC_SITE_URL=
