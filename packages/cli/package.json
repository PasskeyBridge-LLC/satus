{
  "name": "@passkeybridge/satus",
  "version": "0.3.13",
  "description": "Generate realistic seed data for Postgres. Respects foreign keys, constraints, and your schema.",
  "license": "SEE LICENSE IN LICENSE",
  "author": "PasskeyBridge LLC <support@satus.sh>",
  "homepage": "https://satus.sh",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PasskeyBridge-LLC/satus.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/PasskeyBridge-LLC/satus/issues",
    "email": "support@satus.sh"
  },
  "bin": {
    "satus": "dist/cli.js"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "type": "module",
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run typecheck && npm run build"
  },
  "dependencies": {
    "commander": "^12.1.0",
    "pg": "^8.13.1",
    "picocolors": "^1.1.1",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/pg": "^8.23.1",
    "@typescript-eslint/eslint-plugin": "^8.72.2",
    "@typescript-eslint/parser": "^8.72.2",
    "eslint": "^9.16.0",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^4.1.12"
  },
  "keywords": [
    "postgres",
    "postgresql",
    "seed",
    "seed-data",
    "fixtures",
    "database",
    "cli",
    "developer-tools"
  ],
  "publishConfig": {
    "access": "public"
  },
  "overrides": {
    "brace-expansion@^1.1.0": "1.1.22",
    "js-yaml@^4.0.0": "4.3.2"
  }
}
